{
  "name": "vue-library",
  "version": "1.0.0",
  "module": "dist/vue-library.mjs",
  "types": "dist/types/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./dist/vue-library.mjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "main": "dist/vue-library.mjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.5.40",
    "highcharts": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^2.2.12",
    "vue-i18n": "^11.4.7"
  }
}
