{
  "name": "vue-library",
  "version": "1.0.0",
  "module": "dist/vue-library.mjs",
  "types": "dist/types/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./dist/vue-library.mjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "main": "dist/vue-library.mjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "highcharts": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^2.2.4",
    "vue-i18n": "^11.2.8"
  },
  "packageManager": "pnpm@10.34.0"
}
